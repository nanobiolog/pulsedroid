<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zero-Pulse Surface Calibration"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Place your phone flat on a table or stable surface. Do not touch or shake it during calibration. This ensures 0 BPM when resting on a table."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/pb_calib_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_cyan" />

    <TextView
        android:id="@+id/tv_calib_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ready: Place on table and tap Start"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_calib_values"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Current Noise Floor: -- m/s²"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
